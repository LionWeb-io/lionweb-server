{
    "name": "@lionweb/server-test",
    "version": "0.4.0-beta.3",
    "private": true,
    "main": "src/server.ts",
    "types": "./dist/index.d.ts",
    "typings": "./dist/index.d.ts",
    "type": "module",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/LionWeb-io/lionweb-server.git"
    },
    "bugs": {
        "url": "https://github.com/LionWeb-io/lionweb-server/issues"
    },
    "scripts": {
        "clean": "rm -rf node_modules/ && rm -rf dist/ && rm -rf data/ && rm -rf delta/",
        "build": "tsc",
        "alive": "echo I am alive",
        "lint": "eslint src",
        "manualtest": "node dist/test/ManualTests.js",
        "setup": "npm run install-bulk-data && npm run install-delta-data",
        "install-bulk-data": "npx degit https://github.com/LionWeb-io/lionweb-integration-testing/testchanges/data/ data",
        "install-delta-data": "npx degit https://github.com/LionWeb-io/lionweb-integration-testing/delta/ delta",
        "test": "vitest --run --fileParallelism=false  --silent=false ./src/test/test.test.ts ./src/test/inspectionTests.test.ts ./dist/test/tests-issue19.test.ts ./src/test/history.test.ts ./src/test/sequentialize-requests.test.ts",
        "test-logo": "vitest --run --open --fileParallelism=false  --silent=false ./src/test/delta/test-logo-deltas.test.ts",
        "test2": "vitest --fileParallelism=false ./src/test/test.test.ts",
        "test-additional": "vitest --run src/test/additional-api.test.ts",
        "test-bulk": "vitest --run src/test/bulk-import.test.ts",
        "test-history": "vitest --run --fileParallelism=false ./src/test/history.test.ts",
        "test3": "vitest --run --fileParallelism=false ./src/test/test.test.ts && vitest --run ./src/test/inspectionTests.test.ts  && vitest --run ./src/test/history.test.ts && vitest --run ./src/test/sequentialize-requests.test.ts && vitest --run ./src/test/tests-issue19.test.ts"
    },
    "devDependencies": {
        "prettier": "3.1.0",
        "@typescript-eslint/eslint-plugin": "6.13.2",
        "@typescript-eslint/parser": "6.13.2",
        "@types/chai": "4.3.11",
        "degit": "2.8.4",
        "eslint": "8.56.0",
        "chai": "4.3.10",
        "typescript": "5.9.3",
        "vitest": "3.2.4",
        "@vitest/ui": "3.2.4",
        "@vitest/coverage-v8": "3.2.4"
    },
    "dependencies": {
        "@lionweb/validation": "0.9.0-beta.0",
        "@lionweb/json": "0.9.0-beta.0",
        "@lionweb/json-diff": "0.9.0-beta.0",
        "@lionweb/json-utils": "0.9.0-beta.0",
        "@lionweb/server-delta-client": "0.4.0-beta.3",
        "@lionweb/server-delta-shared": "0.4.0-beta.3",
        "@lionweb/server-client": "0.4.0-beta.3",
        "@types/express": "4.17.21",
        "@types/source-map-support": "0.5.10",
        "body-parser": "2.0.2",
        "cors": "2.8.5",
        "dotenv": "16.3.1",
        "express": "4.21.2",
        "fs-extra": "11.1.1",
        "nodemon": "3.0.1",
        "pg": "8.11.3",
        "pg-promise": "11.7.8",
        "source-map-support": "0.5.21"
    }
}
