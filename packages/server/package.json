{
    "name": "@lionweb/server-server",
    "version": "0.4.0-beta.5",
    "private": false,
    "main": "dist/index.js",
    "exports": "dist/index.js",
    "types": "dist/index.d.ts",
    "typings": "dist/index.d.ts",
    "type": "module",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/LionWeb-io/lionweb-server.git"
    },
    "bugs": {
        "url": "https://github.com/LionWeb-io/lionweb-server/issues"
    },
    "scripts": {
        "clean": "rm -rf node_modules/ && rm -rf dist/",
        "dev-local-setup": "node dist/bin/lionweb-server.js --setup --config server-config.json",
        "dev-local-run": "node dist/bin/lionweb-server.js -- --run --config server-config.json",
        "dev-nas-setup": "node dist/bin/lionweb-server.js --setup --config server-config-titania.json",
        "dev-nas-run": "node dist/bin/lionweb-server.js -- --run --config server-config-titania.json",
        "dev-ci-setup": "node dist/bin/lionweb-server.js --setup --config server-config-ci.json",
        "dev-ci-run": "node dist/bin/lionweb-server.js -- --run --config server-config-ci.json",
        "build": "tsc",
        "alive": "echo I am alive",
        "lint": "eslint src",
        "release-beta": "npm publish --tag beta --access=public",
        "publish-local": "npm publish --registry http://localhost:4873 --tag local",
        "unpublish-local": "npm unpublish --force --registry http://localhost:4873",
        "republish-local": "npm run unpublish-local && npm run publish-local",
        "manualtest": "node dist/test/ManualTests.js"
    },
    "devDependencies": {
        "prettier": "3.1.0",
        "@types/chai": "4.3.11",
        "@types/cors": "^2.8.17",
        "@types/ws": "^8.18.1",
        "eslint": "10.1.0",
        "chai": "4.3.10",
        "typescript": "5.9.3"
    },
    "dependencies": {
        "@lionweb/server-common": "0.4.0-beta.5",
        "@lionweb/server-dbadmin": "0.4.0-beta.5",
        "@lionweb/server-inspection": "0.4.0-beta.5",
        "@lionweb/server-additionalapi": "0.4.0-beta.5",
        "@lionweb/server-languages": "0.4.0-beta.5",
        "@lionweb/server-bulkapi": "0.4.0-beta.5",
        "@lionweb/server-history": "0.4.0-beta.5",
        "@lionweb/server-shared": "0.4.0-beta.5",
        "@lionweb/delta-server": "0.4.0-beta.5",
        "@lionweb/server-delta-definitions": "0.4.0-beta.5",
        "@lionweb/server-delta-shared": "0.4.0-beta.5",
        "@lionweb/validation": "0.9.0-beta.3",
        "@types/express": "4.17.21",
        "@types/pg-copy-streams": "^1.2.5",
        "body-parser": "2.0.2",
        "cors": "2.8.5",
        "dotenv": "16.3.1",
        "express": "4.21.2",
        "fs-extra": "11.1.1",
        "nodemon": "3.0.1",
        "pg": "8.11.3",
        "pg-copy-streams": "^6.0.6",
        "pg-promise": "11.7.8",
        "source-map-support": "0.5.21",
        "ws": "^8.18.2"
    },
    "bin": {
        "lionweb-server": "dist/bin/lionweb-server.js"
    },
    "engines": {
        "npm": ">=11.0.0",
        "node": ">=24.0.0"
    }
}
