{
    "private": false,
    "name": "@lionweb/server-client",
    "publishConfig": {
        "access": "public"
    },
    "version": "0.4.0-beta.4",
    "description": "Library to access LionWeb server from a TypeScript/JavaScript client",
    "main": "dist/index.js",
    "exports": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typings": "dist/index.d.ts",
    "type": "module",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/LionWeb-io/lionweb-server.git"
    },
    "bugs": {
        "url": "https://github.com/LionWeb-io/lionweb-server/issues"
    },
    "scripts": {
        "clean": "rm -rf node_modules/ && rm -rf dist/",
        "build": "tsc",
        "lint": "eslint src",
        "release-beta": "npm publish --tag beta",
        "publish-local": "npm publish --registry http://localhost:4873 --tag beta",
        "unpublish-local": "npm unpublish --force --registry http://localhost:4873",
        "republish-local": "npm run unpublish-local && npm run publish-local"
    },
    "dependencies": {
        "@lionweb/json": "0.9.0-beta.0",
        "@lionweb/server-shared": "0.4.0-beta.4"
    },
    "devDependencies": {
        "prettier": "3.1.0",
        "@typescript-eslint/eslint-plugin": "6.13.2",
        "@typescript-eslint/parser": "6.13.2",
        "@types/chai": "4.3.11",
        "eslint": "8.56.0",
        "chai": "4.3.10",
        "typescript": "5.9.3"
    }
}
