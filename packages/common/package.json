{
    "name": "@lionweb/server-common",
    "version": "0.4.0-beta.5",
    "private": false,
    "description": "Common code for the lionweb server",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "typings": "dist/index.d.ts",
    "type": "module",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/LionWeb-io/lionweb-server.git"
    },
    "bugs": {
        "url": "https://github.com/LionWeb-io/lionweb-server/issues"
    },
    "scripts": {
        "clean": "rm -rf node_modules/ && rm -rf dist/",
        "build": "tsc",
        "lint": "eslint src",
        "release-beta": "npm publish --tag beta --access=public",
        "publish-local": "npm publish --registry http://localhost:4873 --tag beta",
        "unpublish-local": "npm unpublish --force --registry http://localhost:4873",
        "republish-local": "npm run unpublish-local && npm run publish-local"
    },
    "devDependencies": {
        "@types/uuid": "^10.0.0"
    },
    "dependencies": {
        "@lionweb/json": "0.10.0-beta.0",
        "@lionweb/json-utils": "0.10.0-beta.0",
        "@lionweb/json-diff": "0.10.0-beta.0",
        "@lionweb/validation": "0.10.0-beta.0",
        "@lionweb/server-shared": "0.4.0-beta.5",
        "@lionweb/server-database": "0.4.0-beta.5",
        "@lionweb/server-delta-shared": "0.4.0-beta.5",
        "@types/express": "4.17.21",
        "json-stream-stringify": "3.1.6",
        "pg": "8.11.3",
        "pg-promise": "11.7.8",
        "source-map-support": "0.5.21",
        "uuid": "9.0.1",
        "@types/express": "4.17.21",
        "express": "4.21.2"
    },
    "files": [
        "dist",
        "src"
    ]
}
