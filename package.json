{
    "name": "@lionweb/server",
    "version": "0.4.0",
    "type": "module",
    "private": true,
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/LionWeb-io/lionweb-server.git"
    },
    "bugs": {
        "url": "https://github.com/LionWeb-io/lionweb-server/issues"
    },
    "scripts": {
        "initialize": "npm run clean && npm install && npm run setup && npm run build",
        "clean": "rm -rf node_modules/ && rm -f package-lock.json && npm run clean -w packages --if-present",
        "build": "npm run build -w packages --if-present",
        "lint": "npm run lint -w packages --if-present",
        "setup": "npm run setup -w packages --if-present",
        "test": "npm run test -w packages --if-present",
        "release-beta": "npm run release-beta -w packages --if-present",
        "release": "npm run release -w packages --if-present",
        "database": "node packages/dbadmin/dist/tools/database",
        "install-local": "npm install --registry http://localhost:4873",
        "publish-local": "npm run publish-local -w packages --if-present",
        "unpublish-local": "npm run unpublish-local -w packages --if-present",
        "republish-local": "npm run republish-local -w packages --if-present",
        "publish-docker": "bash scripts/tag-and-release-docker-image.sh",
        "dependency-graph": "npx monorepo-mapper",
        "check-dependencies": "npx  syncpack lint --source 'package.json' --source 'packages/*/package.json'",
        "list-dependencies": "npx  syncpack list --source 'package.json' --source 'packages/*/package.json'"
    },
    "devDependencies": {
        "@changesets/cli": "2.31.0",
        "@changesets/config": "3.0.0",
        "@eslint/compat": "2.0.2",
        "@eslint/eslintrc": "3.3.3",
        "@eslint/js": "10.0.1",
        "@types/pg": "8.20.0",
        "@types/ws": "8.18.1",
        "@typescript-eslint/eslint-plugin": "8.57.2",
        "@typescript-eslint/parser": "8.57.2",
        "@vitest/eslint-plugin": "1.6.20",
        "changesets": "1.0.2",
        "eslint": "10.1.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-n": "17.24.0",
        "eslint-plugin-node": "11.1.0",
        "prettier": "3.1.0",
        "ts-protoc-gen": "0.15.0",
        "typescript": "5.9.3",
        "typescript-eslint": "8.57.2"
    },
    "overrides": {
        "vite": {
            "rollup": "npm:@rollup/wasm-node"
        }
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-arm64-gnu": "4.62.0"
    },
    "workspaces": [
        "./packages/shared",
        "./packages/delta-shared",
        "./packages/server-delta-definitions",
        "./packages/database",
        "./packages/common",
        "./packages/client",
        "./packages/delta-client",
        "./packages/dbadmin",
        "./packages/languages",
        "./packages/inspection",
        "./packages/bulkapi",
        "./packages/history",
        "./packages/additionalapi",
        "./packages/delta-server",
        "./packages/server",
        "./packages/test",
        "./scripts",
        "."
    ],
    "engines": {
        "npm": ">=11.0.0",
        "node": ">=24.0.0"
    }
}
